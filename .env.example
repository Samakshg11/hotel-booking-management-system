# Server & Environment Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Replica Set required for multi-document transactions)
# Local Docker Replica Set:
MONGODB_URI=mongodb://127.0.0.1:27017/hotel_management?replicaSet=rs0
# Or MongoDB Atlas M0 Free Tier URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/hotel_management?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_takehome_demo_only_min_32_characters_long
JWT_EXPIRES_IN=7d

# Business Rules
HOLD_MINUTES=10
TAX_RATE=0.12
ALLOW_EARLY_CHECKIN=false
MAX_STAY_NIGHTS=30

# Logging
LOG_LEVEL=info
